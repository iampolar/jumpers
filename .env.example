# ---------------------------------------------------------------------------
# CastWave — exemplo de configuracao
#
# Copie para `.env` e ajuste. Este arquivo NAO contem segredo real: apenas
# nomes, formatos e valores de exemplo claramente marcados.
#
# Em desenvolvimento nada aqui e obrigatorio: `npm run dev` sobe com PGlite em
# disco, storage local e todas as integracoes externas desligadas. Em producao
# a API valida tudo no boot e se recusa a subir com configuracao incoerente.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Banco de dados
#
#   memory://              PostgreSQL embarcado em memoria (testes)
#   file://./.data/castwave PostgreSQL embarcado em disco (dev, sem Docker)
#   postgres://user:senha@host:5432/castwave   PostgreSQL gerenciado (producao)
#
# Em producao so a terceira forma e aceita.
# ---------------------------------------------------------------------------
DATABASE_URL=file://./.data/castwave
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Segredos
#
# Gere cada um separadamente:   openssl rand -base64 48
#
# Precisam ser DIFERENTES entre si: comprometer a assinatura das URLs de audio
# nao pode entregar junto a capacidade de forjar sessao. Minimo de 32 bytes.
# Em desenvolvimento, se ficarem vazios, a API gera valores efemeros e marca
# como "efemero (dev)" no log de boot.
# ---------------------------------------------------------------------------
SESSION_SECRET=
SESSION_TTL_HOURS=336
MEDIA_URL_SECRET=
MEDIA_URL_TTL_SECONDS=300

# Origem do painel. Entra no CORS e no SameSite do cookie. https em producao.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Armazenamento de audio
#
# `local` grava em disco e serve para desenvolvimento. Em producao use `s3`
# (compativel: AWS S3, Cloudflare R2, MinIO) e preencha todas as S3_*.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.data/storage
# S3_ENDPOINT=https://s3.sa-east-1.amazonaws.com
# S3_REGION=sa-east-1
# S3_BUCKET=castwave-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Filas
#
#   postgres  fila transacional na tabela `jobs` (padrao, sem servico extra)
#   inline    executa no proprio processo; use so para depurar
# ---------------------------------------------------------------------------
QUEUE_DRIVER=postgres

# ---------------------------------------------------------------------------
# Processamento de audio
#
# Sem FFmpeg o produto continua funcionando: a duracao e lida do cabecalho do
# arquivo pela sonda nativa. O que se perde e normalizacao de volume e medicao
# de loudness — e o /health/ready diz isso explicitamente, em vez de fingir.
# ---------------------------------------------------------------------------
# FFPROBE_PATH=/usr/bin/ffprobe
# FFMPEG_PATH=/usr/bin/ffmpeg

# Segundos sem heartbeat ate o player ser considerado offline pelo servidor.
DEVICE_OFFLINE_AFTER_SECONDS=180

RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Integracoes externas — TODAS desligadas por padrao
#
# O produto inteiro (lojas, zonas, upload, anuncios, playlists, agenda,
# campanhas, player, relatorios, planos e uso) funciona com tudo em `disabled`.
# Cada uma so entra quando houver fornecedor escolhido e credencial fornecida.
# ---------------------------------------------------------------------------

# disabled | mock   (`mock` e recusado em producao pela validacao de config)
AI_COPY_PROVIDER=disabled
AI_TTS_PROVIDER=disabled

# disabled | fake   (`fake` e recusado em producao pela validacao de config)
PAYMENTS_PROVIDER=disabled

# Sem SMTP, convites e alertas ficam na central de notificacoes do app. O
# sistema registra `not_configured` — nunca reporta entrega que nao aconteceu.
# SMTP_URL=smtp://usuario:senha@smtp.exemplo.com:587

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
CASTWAVE_API_ORIGIN=http://127.0.0.1:4000
